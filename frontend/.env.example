# Copy to .env.local to override. Never put secrets here: every VITE_* value is shipped to the browser.

# Where the Vite dev/preview proxy forwards /api and /ws (server-side only, not exposed to the client).
DEFENCEIQ_BACKEND=http://127.0.0.1:8000

# Optional: absolute API origin. Leave empty to use the same-origin proxy (recommended —
# the prototype backend does not send CORS headers).
VITE_API_BASE=

# Optional: absolute WebSocket URL (e.g. ws://127.0.0.1:8000/ws). Empty = same origin /ws.
VITE_WS_URL=

