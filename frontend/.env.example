# ==============================================================================
# DefenceIQ Frontend Environment Configuration
# ==============================================================================
# Copy to .env.local for local overrides, or configure in Vercel project settings.
# IMPORTANT: Never place API keys or secrets in this file. All VITE_* variables
# are embedded directly into public client-side JavaScript bundles.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Local Development (with Vite reverse-proxy)
# ------------------------------------------------------------------------------
# Where the Vite dev server (/api and /ws) proxies incoming requests.
# Keep VITE_API_BASE and VITE_WS_URL empty so the browser uses same-origin paths.
DEFENCEIQ_BACKEND=http://127.0.0.1:8000

# ------------------------------------------------------------------------------
# 2. Production Deployment (e.g. Vercel -> Render)
# ------------------------------------------------------------------------------
# Base HTTPS URL for the deployed FastAPI backend on Render.
# Example: https://defenceiq-api.onrender.com
VITE_API_BASE=

# Absolute WebSocket WSS URL for the deployed FastAPI backend on Render.
# If omitted but VITE_API_BASE is set, the client will automatically derive
# wss://<VITE_API_BASE host>/ws.
# Example: wss://defenceiq-api.onrender.com/ws
VITE_WS_URL=


